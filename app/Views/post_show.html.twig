{% set asset_path = '../assets/' %}
{% extends "components/base/base.html.twig" %}

{% block body %}
	<div class="post-container container my-5">

		<!-- Post Header Section -->
		<div class="post-header mb-4">
			<h1 class="post-title display-4">{{ post.title }}</h1>
			<p class="post-lede text-muted">{{ post.lede }}</p>
			<div class="post-meta text-muted small d-flex justify-content-between">
                <span>Écrit par <strong>
                        {% if post.user is not null %}
							{{ post.user.firstName }} {{ post.user.lastName }}
						{% else %}
							Inconnu
						{% endif %}
                    </strong></span>
				<span>Mis à jour le {{ post.updatedAt ? post.updatedAt|date("d M Y") : post.createdAt|date("d M Y") }}</span>
				<span>{{ post.views }} vues</span>
			</div>
			<hr>
		</div>

		<!-- Post Content Section -->
		<div class="post-content mb-5">
			<div class="post-body lead mt-4">{{ post.content | raw }}</div>
		</div>

		<!-- Comments Section -->
		<div class="comments-section mt-5">
			<div class="card shadow-sm">
				<div class="card-header bg-primary text-white">
					<h3 class="m-0">Commentaires</h3>
				</div>
				<div class="card-body">
					{% if comments|length > 0 %}
						{% for comment in comments %}
							{% if comment.validated %}
							<div class="comment mb-4 p-3 border-bottom">
								<div class="comment-author fw-bold mb-2">{{ comment.user.firstName }} {{ comment.user.lastName }}</div>
								<div class="comment-content text-muted">{{ comment.content | striptags }}</div>
								<div class="comment-date small text-end text-muted">{{ comment.updatedAt | date("d-m-Y H:i") }}</div>
							</div>
							{% endif %}
						{% endfor %}
					{% else %}
						<p class="text-center text-muted">Aucun commentaire pour le moment. Soyez le premier à commenter !</p>
					{% endif %}
				</div>
			</div>
		</div>

		<!-- Add Comment Button -->
		<div class="add-comment mt-4 text-end">
			<a href="{{ path('comment_add_form', {'id': post.id}) }}" class="btn btn-primary rounded">Ajouter un commentaire</a>
		</div>

	</div>
{% endblock %}
