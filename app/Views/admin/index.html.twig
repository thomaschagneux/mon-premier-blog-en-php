{% extends "components/base/base_admin.html.twig" %}

{% block body %}

    <div class="container mt-5">
        <div class="row">
            <div class="col-md-12 text-center">
                <h1 class="display-4">Bienvenue, {{ user.firstName }} {{ user.lastName}} !</h1>
                <p class="lead">Nous sommes heureux de vous revoir sur votre tableau de bord.</p>
                <hr class="my-4">
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="card-title">Derniers posts</h5>
                        <ul class="list-unstyled">
                            <li>
                                <a href="{{ path('post_show', {'id': posts[0].id}) }}" class="card-text">{{ posts[0].title }}</a>
                            </li>
                            <li>
                                <a href="{{ path('post_show', {'id': posts[1].id}) }}" class="card-text">{{ posts[1].title }}</a>
                            </li>
                            <li>
                                <a href="{{ path('post_show', {'id': posts[2].id}) }}" class="card-text">{{ posts[2].title }}</a>
                            </li>
                        </ul>
                        <a href="{{ path('list_post')}}" class="btn btn-primary">Voir les posts</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="card-title">Profil utilisateur</h5>
                        <p class="card-text">Mettez à jour vos informations personnelles ou changez votre mot de passe.</p>
                        <a href="{{ path('user_edit_form', {'id': user.id}) }}" class="btn btn-primary">Modifier le profil</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="card-title">Statistiques personnelles</h5>
                        <p class="card-text">
                            Posts publiés : <span class="counter" data-count="{{ total_posts }}">0</span> <br>
                            Commentaires : <span class="counter" data-count="{{ total_comments }}">0</span> <br>
                            Vues totales : <span class="counter" data-count="{{ views }}">0</span>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- jQuery pour l'animation des compteurs -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>

    <script>
        $(document).ready(function() {
            $('.counter').each(function() {
                let $this = $(this),
                    countTo = $this.attr('data-count');

                $({ countNum: $this.text() }).animate({
                        countNum: countTo
                    },
                    {
                        duration: 2000,
                        easing: 'swing',
                        step: function() {
                            $this.text(Math.floor(this.countNum));
                        },
                        complete: function() {
                            $this.text(this.countNum);
                        }
                    });
            });
        });
    </script>

{% endblock %}