{% extends "components/base/base.html.twig" %}

{% block scripts %}
    <script src="https://www.google.com/recaptcha/api.js?render={{ recaptcha_site_key }}"></script>
    <script>
      grecaptcha.ready(function() {
        grecaptcha.execute('{{ recaptcha_site_key }}', {action: 'submit'}).then(function(token) {
          document.getElementById('g-recaptcha-response').value = token;
        });
      });
    </script>
{% endblock %}

{% block body %}

    <div class="container">

        <div class="intro mb-3 p-4 bg-light border rounded-3">
            <h2>A propos de moi</h2>
            <p  class="text-indent">
                Bonjour, je m'appelle <strong>Thomas Chagneux</strong> et je suis un <strong>développeur PHP junior</strong> passionné.
                Je m'intéresse particulièrement au développement web et j'ai une <strong>curiosité constante</strong> pour les nouvelles technologies.
            </p>
            <p>
                    Après des études en développement informatique et plusieurs projets académiques, je me spécialise aujourd'hui en PHP
                et j'explore ses frameworks populaires, notamment <strong>Symfony</strong>.
            </p>
            <p>
                    Grâce à mes projets personnels et mes exercices académiques, j'ai développé de solides compétences en <strong>PHP</strong>,
                ainsi qu'une bonne maîtrise des bases du <strong>HTML, CSS et JavaScript</strong>. Mon objectif est de concevoir des
                applications web modernes, fonctionnelles et accessibles.
            </p>
            <p>
                    En tant que développeur junior, je suis motivé par l'apprentissage continu et je cherche toujours à
                améliorer mes compétences à chaque nouveau projet. Que ce soit par la lecture de documentation, des cours en ligne
                ou la collaboration avec d'autres développeurs, <strong>j'aime relever des défis</strong> pour progresser.
            </p>
            <p>
                    Vous cherchez un développeur motivé et en pleine évolution ? <strong>Je serais ravi d’échanger avec vous</strong> et
                de contribuer à vos projets avec enthousiasme et détermination!
            </p>

            <div class="skills mt-3">
                <h3>Compétences</h3>
                <span class="badge bg-primary m-1">PHP</span>
                <span class="badge bg-secondary m-1">Symfony</span>
                <span class="badge bg-info m-1">HTML</span>
                <span class="badge bg-warning m-1">CSS</span>
                <span class="badge bg-success m-1">JavaScript</span>
            </div>
        </div>

        <div class="contact-form mb-3">
            <h2>Me contacter</h2>
            <form action="{{ path('contact') }}" enctype="multipart/form-data" method="post">
                <div class="row mb-2">
                    <div class="col col-md-6">{{ contact_form.firstName | raw }}</div>
                    <div class="col col-md-6">{{ contact_form.lastName | raw }}</div>
                </div>
                <div class="row mb-2">
                    <div class="col col-md-6">{{ contact_form.email | raw }}</div>
                </div>
                <div class="row mb-2">
                    <div class="">{{ contact_form.message | raw }}</div>
                </div>
                <div class="row">
                    <input type="hidden" name="g-recaptcha-response" id="g-recaptcha-response">
                </div>
                <div class="d-flex justify-content-center justify-content-md-end">
                    <button type="submit" class="btn btn-primary rounded-2">Valider</button>
                </div>
            </form>
        </div>

        <div class="latest-posts mt-5">
            <h2>Derniers articles</h2>

            <!-- Dernier article en vedette -->
            <div class="row mb-4">
                {% if last_post %}
                    <div class="col-12 mb-4 slide-in">
                        <div class="card h-100 shadow-lg featured-post">
                            {% if last_post.featuredImage %}
                                <img src="{{ last_post.featuredImage.pathName }}{{ last_post.featuredImage.fileName }}" class="card-img-top" alt="{{ last_post.title }}">
                            {% endif %}
                            <div class="card-body">
                                <h3 class="card-title">{{ last_post.title }}</h3>
                                <p class="card-text">{{ last_post.lede | slice(0, 200) ~ '...' }}</p>
                                <a href="{{ path('front_post_show', { id: last_post.id }) }}" class="btn btn-primary btn-lg">Lire la suite</a>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>

            <!-- Autres articles -->
            <div class="row">
                {% for post in posts | slice(1, 3) %}
                    <div class="col-md-4 mb-4 slide-in">
                        <div class="card h-100 shadow-sm">
                            {% if post.getFeaturedImage %}
                                <img src="{{ post.getFeaturedImage.pathName }}{{ post.getFeaturedImage.fileName }}" class="post-image" alt="{{ post.title }}">
                            {% endif %}
                            <div class="card-body">
                                <h5 class="card-title">{{ post.title }}</h5>
                                <p class="card-text">{{ post.lede | slice(0, 100) ~ '...' }}</p>
                                <a href="{{ path('front_post_show', { id: post.id}) }}" class="btn btn-outline-primary btn-sm">Lire la suite</a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

    </div>

{% endblock %}